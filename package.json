{
  "name": "android-apidemos",
  "version": "6.0.17",
  "description": "A fork of Google's Android ApiDemos application, used for testing Appium",
  "keywords": [
    "android",
    "apidemos",
    "appium"
  ],
  "homepage": "https://github.com/appium/android-apidemos",
  "bugs": {
    "url": "https://github.com/appium/android-apidemos/issues"
  },
  "license": "Apache-2.0",
  "author": "Appium Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/appium/android-apidemos.git"
  },
  "directories": {},
  "files": [
    "./index.js",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "index.js",
  "scripts": {
    "bump-gradle-version": "node ./scripts/gradle-version-update.mjs --package-version=${npm_package_version} && git add app/build.gradle",
    "build": "npm run build:debug",
    "build:debug": "./gradlew assembleDebug",
    "build:release": "./gradlew assembleRelease",
    "build:clean": "./gradlew clean",
    "lint": "oxlint -c oxlint.config.mjs .",
    "lint:fix": "oxlint -c oxlint.config.mjs --fix .",
    "format": "oxfmt -c oxfmt.config.mjs .",
    "format:check": "oxfmt -c oxfmt.config.mjs --check .",
    "version": "npm run bump-gradle-version",
    "clean": "rm -rf node_modules && rm -f package-lock.json && npm install"
  },
  "devDependencies": {
    "@appium/oxc-config": "^1.1.0",
    "@appium/semantic-release-config": "^1.1.0",
    "semver": "^7.3.7"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10"
  }
}
